# Set one API key. Clausemark uses the first one it finds in this order:
# Gemini, Anthropic, OpenAI. With no key at all it uses a local Ollama model.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: force a provider (gemini, anthropic, openai or ollama)
LLM_PROVIDER=

# Optional: change the model for a provider
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5.4-mini
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_URL=http://localhost:11434

# Optional: which question set the web app uses (sample, mini or full)
# ACTIVE_SET=mini

# Optional: seconds to wait for one hosted LLM call
# LLM_TIMEOUT_SECONDS=60
